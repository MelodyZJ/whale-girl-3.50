# 运行时数据：包含 API Key、聊天记录、人设、词库、日志、微信数据库快照，绝不入库
data/
config.json
wechatauto_logs/
wechatauto_db/

# 依赖 / 缓存
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# 日志 / 临时产物
*.log
*.tmp
*.zip
dist/
release/

# 系统
.DS_Store
Thumbs.db

# 微信安装包 / 本地工具（tools/ 是项目自己的热键脚本，要入库）
vendor/
scripts/node-path.local

# 包内自带的运行时（要入库；覆盖上方 __pycache__ / *.zip / *.py[cod] 等全局规则）
!runtime/
!runtime/**
